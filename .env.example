# Anthropic API key — used by backend/app/agent.py
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string. Must match docker-compose.yml's `db` service
# credentials if you're using it as-is.
DATABASE_URL=postgresql://expense_user:expense_pass@localhost:5432/expense_db

# Comma-separated list of origins the backend's CORS middleware allows.
CORS_ORIGINS=http://localhost:5173

# Auth0: the tenant and API (audience) whose access tokens the backend
# accepts. Not secrets; the backend never needs an Auth0 client secret.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://expense-assistant-api

# Max chat messages per user per UTC day (bounds Anthropic spend).
DAILY_MESSAGE_LIMIT=50
