# Copy to .env.local (git-ignored). None of these are secrets: they end up
# in the browser bundle. Never put a client secret here.
VITE_API_URL=http://localhost:8000

# Auth0 Single Page Application settings
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://expense-assistant-api

# Optional: demo logins shown on the sign-in page (public by design; use
# passwords that exist nowhere else). One line of JSON.
# VITE_DEMO_ACCOUNTS=[{"label":"Employee (Sales)","email":"marcus.demo@example.com","password":"..."}]
